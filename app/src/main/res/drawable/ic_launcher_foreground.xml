<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive-icon foreground: stopwatch shape.
  Canvas: 108 × 108 dp. Safe zone (always visible): 18–90 on both axes.

  Geometry scaled ×0.9 from original, centered at (54, 56):
    Crown bar  — y 34, x 47–61
    Stem       — (54,34) to (54,42)
    Body       — circle center (54,60) radius 18  →  spans y 42–78
    12 o'clock — (54,42) to (54,48)
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Crown horizontal bar -->
    <path
        android:strokeWidth="5"
        android:strokeColor="#FFFFFF"
        android:strokeLineCap="round"
        android:pathData="M47,34 L61,34" />

    <!-- Stem connecting crown to circle -->
    <path
        android:strokeWidth="5"
        android:strokeColor="#FFFFFF"
        android:strokeLineCap="round"
        android:pathData="M54,34 L54,42" />

    <!-- Body circle — center (54,60) r=18 -->
    <path
        android:strokeWidth="5.5"
        android:strokeColor="#FFFFFF"
        android:fillColor="#00000000"
        android:pathData="M54,60 m-18,0 a18,18 0 1,0 36,0 a18,18 0 1,0 -36,0" />

    <!-- 12 o'clock tick mark (inside circle, top) -->
    <path
        android:strokeWidth="4"
        android:strokeColor="#FFFFFF"
        android:strokeLineCap="round"
        android:pathData="M54,42 L54,48" />

</vector>
